# FastAPI AI/CV service
HOST=127.0.0.1
PORT=8000
ENV=development

# OCR engine: "paddleocr" or "tesseract" (fallback)
OCR_ENGINE=paddleocr

# Max image dimension (longest side) before resizing for processing
MAX_IMAGE_DIMENSION=1600

# Allow the Node backend origin for CORS
ALLOWED_ORIGIN=http://localhost:5000
